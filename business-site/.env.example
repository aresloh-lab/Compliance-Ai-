# Required for the chat + report features to work. Google AI Studio issues a
# free-tier key at https://aistudio.google.com/apikey.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

PORT=3100

# Protects GET /api/reports (the admin view of submitted reports).
# Set this to a long random string.
ADMIN_KEY=changeme

# Where completed client reports get emailed. Leave blank to skip email
# (reports are always saved to business-site/data/reports.json regardless).
REPORT_TO_EMAIL=

# Email is sent via Resend (https://resend.com) — free tier, no SMTP/2FA
# hassle. Sign up, then copy your API key from resend.com/api-keys.
RESEND_API_KEY=

# Without a verified domain on Resend, the shared "onboarding@resend.dev"
# sender only delivers to the email address you signed up to Resend with —
# that's fine here since REPORT_TO_EMAIL above should be that same address.
# Verify your own domain on Resend later to send from your own address instead.
RESEND_FROM_EMAIL=Threshold <onboarding@resend.dev>
