# AI provider — set as many of these as you like, then pick the active one
# from Profile > AI Provider in the app. At least one is required.
ANTHROPIC_API_KEY=your-api-key-here
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# Optional model overrides — defaults are chosen to be safe/verified-working,
# not necessarily each provider's newest model. Override if you want a
# different one.
# CLAUDE_MODEL=claude-sonnet-4-5
# OPENAI_MODEL=gpt-4o
# GEMINI_MODEL=gemini-3.5-flash-lite

PORT=3001

# Frontend origin — used to redirect the browser back after Google OAuth flows
FRONTEND_URL=http://localhost:5173

# Google Fit (Android only — see README.md "Google Fit setup" for how to get these)
GOOGLE_FIT_CLIENT_ID=
GOOGLE_FIT_CLIENT_SECRET=
GOOGLE_FIT_REDIRECT_URI=http://localhost:3001/api/google-fit/callback

# Google Drive backup — reuses GOOGLE_FIT_CLIENT_ID/SECRET above (same OAuth
# client, different scope + redirect URI). Add this second redirect URI to
# the same OAuth client's "Authorized redirect URIs" list.
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3001/api/google-drive/callback
